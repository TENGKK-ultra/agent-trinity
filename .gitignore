# --- 密钥与凭据（绝不提交） ---
.env
.env.*
*.key
*.pem

# --- 依赖 ---
node_modules/

# --- 运行时数据库（SQLite 不纳入版本控制） ---
trinity-core/data/*.db
trinity-core/data/*.db-journal
trinity-core/data/*.db-wal
trinity-core/data/*.db-shm
# 独立测试实例的临时库、工作目录与 PID 记录
trinity-core/data/test/

# --- 本地预览启动配置（由工具生成，不属于产品代码） ---
.claude/launch.json

# --- 构建产物 ---
dist/
*.tsbuildinfo

# --- 日志与临时文件 ---
*.log
*.tmp
tmp/

# --- Agent workspaces (runtime data) ---
# Root only: trinity-core/src/workspaces is source code, not runtime data.
/workspaces/
